@model CoffeeShop.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-box">
    <h2 class="auth-title">Регистрация</h2>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="auth-message"></div>

        <div class="auth-text-field">
            <input asp-for="Name" placeholder="Имя"/>
        </div>

        <div class="auth-text-field">
            <input asp-for="Phone" placeholder="Телефон (+8 (___) ___-__-__)" />
        </div>

        <div class="auth-text-field">
            <input asp-for="Password" placeholder="Пароль (минимум 8 символов)" />
        </div>

        <button class="auth-btn" type="submit">Зарегистрироваться</button>
        
        <p class="auth-box-footer">Уже есть аккаунт? <a class ="auth-link" asp-action="Login">Войти</a></p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}