@{
    ViewData["Title"] = "Заказ оформлен";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="confirm-card">
    <span class="material-symbols-outlined confirm-icon">task_alt</span>
    <h2 class="confirm-title">Заказ оформлен</h2>

    <form asp-action="PrintReceipt" method="post" class="confirm-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
        <button type="submit" class="confirm-btn">Распечатать чек</button>
    </form>

    <a asp-controller="Catalog" asp-action="Index" class="confirm-btn confirm-btn-link">Вернуться в каталог</a>
</div>